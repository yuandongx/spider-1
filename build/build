
git pull origin devel
last_commit_old=$(cat ./build/last_commit)
last_commit=$(git log -n 1 --pretty=format:"%h")
version=$(cat ./build/version)
image="spider:$version-$last_commit"
echo $last_commit_old == $last_commit ?
if [ "$last_commit_old" = "$last_commit" ];then
    echo no more commit...
    exit 0
fi
echo $last_commit > ./build/last_commit
ENV_LINE=""
for line in $(cat config.ini);
do
    ENV_LINE="$ENV_LINE $line"
done

ENV_LINE="ENV $ENV_LINE"

sed -i -r "s@ENV.*@$ENV_LINE@g" ./build/Dockerfile

docker build -f ./build/Dockerfile -t $image .

cd /home/develop/workspace
sed -i "s@image: spider.*@image: $image@g" docker-compose.yml
# docker-compose -p spider up --force-recreate
